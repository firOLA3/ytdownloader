# Backend configuration. Copy to `.env` for local development.
# On Render set these in the service's Environment tab instead (there is no .env file there).

# --- Required ---
MONGO_URI=mongodb://127.0.0.1:27017/ytdownloader

# --- yt-dlp ---
# Path to the yt-dlp binary. The Docker image installs it at /usr/local/bin/yt-dlp.
YTDLP_BIN=yt-dlp

# --- Proof-of-origin token provider (fixes "Sign in to confirm you're not a bot") ---
# The bgutil provider started by entrypoint.sh. Leave at the default in Docker.
YTDLP_POT_PROVIDER_URL=http://127.0.0.1:4416
# Where the yt-dlp plugin zip lives (set by the Dockerfile).
YTDLP_PLUGIN_DIRS=/opt/yt-dlp-plugins

# Player-client fallback chain, tried in order until one succeeds.
# Default when the PO provider is reachable:  mweb -> tv_simply -> default
# Default when it is not:                     tv_simply -> tv -> default
# Override with pipe-separated clients, e.g. tv_simply|web_safari|default
# YTDLP_PLAYER_CLIENT_CHAIN=

# --- Optional: cookies for age-restricted / members-only video ---
# Path to a Netscape-format cookies.txt exported from a logged-in browser.
# YTDLP_COOKIES=/usr/src/app/cookies.txt

# --- Timeouts (milliseconds) ---
YTDLP_FETCH_TIMEOUT_MS=45000
YTDLP_DOWNLOAD_TIMEOUT_MS=900000
